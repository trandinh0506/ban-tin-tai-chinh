WORDPRESS_PORT=8080
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-this-wordpress-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# CLI đồng bộ bài viết local → production WordPress
LOCAL_WP_URL=http://localhost:8080
# Chỉ cần nếu muốn đọc draft/private local bằng --include-drafts
LOCAL_WP_USERNAME=
LOCAL_WP_APPLICATION_PASSWORD=
PRODUCTION_WP_URL=https://news.example.com
PRODUCTION_WP_USERNAME=publisher-bot
PRODUCTION_WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
PUBLISH_STATE_FILE=.publish-state/sync-map.json
PUBLISH_ALLOW_CREATE_TAXONOMIES=false
